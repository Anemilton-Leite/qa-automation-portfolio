{
  "name": "qa-automation-portfolio",
  "version": "1.0.0",
  "description": "QA Automation Portfolio — Cypress + Playwright + API Tests — Anemilton Leite",
  "author": "Anemilton Leite <Anemilton01@gmail.com>",
  "license": "MIT",
  "scripts": {
    "cy:open":    "cypress open --config-file cypress/cypress.config.js",
    "cy:run":     "cypress run --config-file cypress/cypress.config.js",
    "cy:login":   "cypress run --spec cypress/e2e/auth/login.cy.js --config-file cypress/cypress.config.js",
    "cy:cart":    "cypress run --spec cypress/e2e/cart/cart.cy.js --config-file cypress/cypress.config.js",
    "cy:checkout":"cypress run --spec cypress/e2e/checkout/checkout.cy.js --config-file cypress/cypress.config.js",
    "pw:test":    "playwright test --config=playwright/playwright.config.js",
    "pw:chrome":  "playwright test --config=playwright/playwright.config.js --project=Chrome",
    "pw:firefox": "playwright test --config=playwright/playwright.config.js --project=Firefox",
    "pw:safari":  "playwright test --config=playwright/playwright.config.js --project=Safari",
    "pw:report":  "playwright show-report playwright-report",
    "api:posts":  "node api-tests/posts.test.js",
    "api:users":  "node api-tests/users.test.js",
    "api:test":   "node api-tests/posts.test.js && node api-tests/users.test.js",
    "test:all":   "npm run api:test && npm run cy:run && npm run pw:test"
  },
  "devDependencies": {
    "cypress": "^13.6.0",
    "@playwright/test": "^1.40.0",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.3.0",
    "mochawesome-report-generator": "^6.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
